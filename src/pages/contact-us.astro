---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import CtaBand from "../components/CtaBand.astro";
import { PHONE, PHONE_HREF, EMAIL, ADDRESS_LINES } from "../data/site";
---

<Base
  absoluteTitle="Contact Harborview Law | Free Consultation Newport Beach"
  description="Contact Harborview Law to see how we can support your business needs — by phone, email, or at our Newport Beach office."
>
  <section class="page-hero pad-global">
    <div class="container"><div class="page-hero__inner">
      <span class="eyebrow">Harborview Law</span>
      <h1 class="h1">Contact Us</h1>
      <p class="lede muted">Contact us to see how we can support your business needs.</p>
    </div></div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container contact-grid">
      <div class="contact-info">
        <div>
          <div class="contact-info__label">Email</div>
          <p class="muted" style="margin-bottom: 0.4rem;">Reach out to us with your questions or legal needs. We're here to help.</p>
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>
        <div>
          <div class="contact-info__label">Phone</div>
          <p class="muted" style="margin-bottom: 0.4rem;">Give us a call to discuss your legal needs or schedule a consultation today.</p>
          <a href={PHONE_HREF}>{PHONE}</a>
        </div>
        <div>
          <div class="contact-info__label">Office</div>
          <p class="muted" style="margin-bottom: 0.4rem;">Visit us for expert legal support with your business and real estate needs.</p>
          <p>{ADDRESS_LINES.map((l) => <span>{l}<br /></span>)}</p>
        </div>
        <p class="contact-info__note">
          Our offices are conveniently located for personalized legal support and guidance.
        </p>
      </div>
      <div class="contact-form">
        <p class="lede" style="margin-bottom: 1.75rem;">
          Tell us how we can support your business.
        </p>
        <ContactForm />
      </div>
    </div>
  </section>
</Base>
