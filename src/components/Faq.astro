---
export type FaqEntry = { q: string; a: string };

interface Props {
  items: FaqEntry[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <div class="faq__item">
        <button class="faq__q" aria-expanded="false">
          {item.q}
          <span class="faq__icon" aria-hidden="true">
            +
          </span>
        </button>
        <div class="faq__a">
          <div class="faq__a-inner">
            <p>{item.a}</p>
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  // Accordion: one item open at a time per .faq group.
  document.querySelectorAll<HTMLElement>(".faq").forEach((faq) => {
    const faqItems = Array.from(faq.querySelectorAll<HTMLElement>(".faq__item"));
    faqItems.forEach((faqItem) => {
      const q = faqItem.querySelector<HTMLButtonElement>(".faq__q");
      q?.addEventListener("click", () => {
        const wasOpen = faqItem.classList.contains("faq__item--open");
        faqItems.forEach((other) => {
          other.classList.remove("faq__item--open");
          other.querySelector(".faq__q")?.setAttribute("aria-expanded", "false");
        });
        if (!wasOpen) {
          faqItem.classList.add("faq__item--open");
          q.setAttribute("aria-expanded", "true");
        }
      });
    });
  });
</script>
