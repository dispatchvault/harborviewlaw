---
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Testimonials from "../components/Testimonials.astro";
import CtaBand from "../components/CtaBand.astro";

const why = [
  { t: "Comprehensive Expertise", d: "Access seasoned legal counsel across multiple specialties, including corporate governance, compliance, and risk management." },
  { t: "Cost-Effective", d: "Eliminate the overhead of maintaining an in-house legal team while receiving top-tier advice on demand." },
  { t: "Scalable Support", d: "Adaptable legal solutions for businesses of all sizes—support when you need it, without long-term commitments." },
  { t: "Focused Guidance", d: "Targeted legal advice customized to your industry and business objectives." },
];

const benefits = [
  { t: "On-Demand Availability", d: "Flexible support for transactions, contracts, and compliance issues without delays." },
  { t: "Industry-Specific Expertise", d: "Guidance from professionals with experience in your field." },
  { t: "Proactive Risk Mitigation", d: "Stay ahead of legal challenges with strategic planning and compliance reviews." },
  { t: "Seamless Integration With Your Business", d: "Collaborate with your existing team to meet immediate legal needs efficiently." },
  { t: "Growth-Oriented Support", d: "Align legal strategies with business objectives to drive long-term success." },
  { t: "Regulatory Compliance Assurance", d: "Ensure your business adheres to evolving local, state, and federal laws to avoid penalties and disruptions." },
];
---

<Base
  absoluteTitle="Concierge Legal Solutions | Harborview Law Newport Beach"
  description="Efficient and flexible legal support tailored to your business needs — on-demand availability, industry-specific expertise, and proactive risk mitigation."
  ogImage="/images/stack-of-books.jpg"
>
  <section class="page-hero pad-global">
    <div class="container"><div class="page-hero__inner">
      <span class="eyebrow">Harborview Law</span>
      <h1 class="h1">Concierge Legal Solutions</h1>
      <p class="lede muted">Efficient and flexible legal support tailored to your business needs.</p>
    </div></div>
  </section>

  <section class="section pad-global">
    <div class="container">
      <SectionHeader eyebrow="Why choose us">Why Choose Concierge Legal Services?</SectionHeader>
      <div class="card-grid card-grid--4">
        {
          why.map((w) => (
            <div class="card">
              <h3 class="card__title">{w.t}</h3>
              <p class="card__body">{w.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container split" style="align-items: start;">
      <div>
        <span class="eyebrow">Our benefits</span>
        <h2 class="h2">Key Benefits of Our Services</h2>
        <p class="lede muted">
          Gain access to expert legal support designed to protect your business and drive growth.
          Our services provide cost-effective, flexible, and industry-focused solutions tailored
          to meet your needs. Experience proactive risk management, seamless collaboration, and
          the assurance of staying compliant in a dynamic regulatory landscape.
        </p>
        <a href="/free-consultation" class="btn" style="margin-top: 1.5rem;">Schedule a Call</a>
      </div>
      <div class="split__img">
        <img src="/images/stack-of-books.jpg" alt="Legal reference books" width="720" height="612" loading="lazy" />
      </div>
    </div>
    <div class="container" style="margin-top: 4rem;">
      <div class="card-grid card-grid--3">
        {
          benefits.map((b) => (
            <div class="card">
              <h3 class="card__title">{b.t}</h3>
              <p class="card__body">{b.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pad-global">
    <div class="container">
      <SectionHeader eyebrow="Client Testimonials" center
        >What Our Clients Say</SectionHeader
      >
      <Testimonials count={3} />
    </div>
  </section>

  <CtaBand href="/free-consultation" label="Schedule a Call" />
</Base>
