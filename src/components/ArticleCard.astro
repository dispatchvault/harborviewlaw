---
import { NEWS_CATEGORIES } from "../data/site";

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  image: string;
}

const { slug, title, description, category, image } = Astro.props;
const catName = NEWS_CATEGORIES[category] ?? category;
---

<a class="article-card" href={`/news/${slug}`}>
  <div class="article-card__img">
    <img src={image} alt="" width="640" height="400" loading="lazy" />
  </div>
  <div class="article-card__body">
    <div class="article-card__meta">{catName}</div>
    <h3 class="article-card__title">{title}</h3>
    <p class="article-card__desc">{description}</p>
    <span class="article-card__more">Read more</span>
  </div>
</a>
