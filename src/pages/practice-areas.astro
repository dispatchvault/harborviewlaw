---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ArticleCard from "../components/ArticleCard.astro";
import CtaBand from "../components/CtaBand.astro";

const practices = (await getCollection("practiceAreas")).sort(
  (a, b) => a.data.order - b.data.order
);
const latest = (await getCollection("news"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base
  absoluteTitle="Practice Areas | B2B Legal Services | Harborview Law"
  description="Customized legal solutions for contracts, compliance, and governance — general counsel services, corporate law, commercial contracts, real estate, telecommunications, and legal consultation."
>
  <section class="page-hero pad-global">
    <div class="container"><div class="page-hero__inner">
      <span class="eyebrow">Practice areas</span>
      <h1 class="h1">Comprehensive Legal Support for Your Business</h1>
      <p class="lede muted">
        We provide customized legal solutions for contracts, compliance, and governance, helping
        your business navigate complexities with ease while protecting your interests and
        supporting your growth.
      </p>
    </div></div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container">
      <div class="card-grid card-grid--3">
        {
          practices.map((p) => (
            <a class="card card--hover" href={`/practice-area/${p.id}`} style="text-decoration:none;color:inherit;">
              <h3 class="card__title">{p.data.title}</h3>
              <p class="card__body">{p.data.lede}</p>
              <span class="card__link">Learn more</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pad-global">
    <div class="container">
      <SectionHeader
        eyebrow="News and insight"
        lede="Stay informed with the latest legal trends and industry developments to keep your business ahead."
      >
        Legal Updates and Industry Insights
      </SectionHeader>
      <div class="article-grid">
        {latest.map((a) => <ArticleCard slug={a.id} {...a.data} />)}
      </div>
      <div class="btn-group" style="margin-top: 2.5rem;">
        <a href="/news-and-insight" class="btn btn--secondary">View all</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
