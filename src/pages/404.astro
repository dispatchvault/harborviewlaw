---
// The live site's Webflow 404 page, captured and served as Astro's 404.
import fs from "node:fs";
import path from "node:path";

const RAW = path.resolve(process.cwd(), "src/raw");
let html = fs.readFileSync(path.resolve(RAW, "__404__.html"), "utf8");
html = html.replace(/^\s*<!DOCTYPE html>\s*/i, "");
---

<Fragment set:html={html} />
