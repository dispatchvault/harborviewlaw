---
import { LEGAL_NAME, PHONE, PHONE_HREF, EMAIL, ADDRESS_LINES, PRACTICE_LINKS } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="footer pad-global">
  <div class="container">
    <div class="footer__top">
      <div>
        <a href="/" class="footer__logo" aria-label="Harborview Law home">
          <img src="/images/logo-hvl.svg" alt="Harborview Law" width="180" height="42" />
        </a>
        <p class="footer__contact">
          Office: {ADDRESS_LINES.join(", ")}<br />
          Contact: <a href={PHONE_HREF}>{PHONE}</a><br />
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </p>
      </div>
      <nav aria-label="Footer">
        <div class="footer__heading">Explore</div>
        <div class="footer__links">
          <a href="/about">About</a>
          <a href="/profile">Profile</a>
          <a href="/practice-areas">Practice Areas</a>
          <a href="/news-and-insight">News &amp; Insights</a>
          <a href="/contact-us">Contact</a>
          <a href="/free-consultation">Free Consultation</a>
        </div>
      </nav>
      <nav aria-label="Practice areas">
        <div class="footer__heading">Practice Areas</div>
        <div class="footer__links">
          {PRACTICE_LINKS.map((p) => <a href={`/practice-area/${p.slug}`}>{p.label}</a>)}
        </div>
      </nav>
    </div>
    <div class="divider"></div>
    <div class="footer__bottom">
      <span>© {year} {LEGAL_NAME} | Site by <a href="https://www.wearezinc.com">ZINC</a></span>
      <span>
        <a href="/policy/privacy-policy">Privacy Policy</a> ·
        <a href="/policy/terms-of-service">Terms of Service</a> ·
        <a href="/policy/cookies-settings">Cookies Settings</a>
      </span>
    </div>
  </div>
</footer>
