---
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="section pad-global">
    <div class="container" style="max-width: 40rem; text-align: center;">
      <span class="eyebrow">404</span>
      <h1 class="h2" style="margin: 1rem 0 1.5rem;">Page Not Found</h1>
      <p class="lede muted" style="margin: 0 auto 2rem;">
        The page you're looking for doesn't exist or has moved.
      </p>
      <a href="/" class="btn">Back to Home</a>
    </div>
  </section>
</Base>
