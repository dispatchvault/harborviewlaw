---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import { NEWS_CATEGORIES } from "../../data/site";

export async function getStaticPaths() {
  return Object.keys(NEWS_CATEGORIES).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const catName = NEWS_CATEGORIES[category!];

const articles = (await getCollection("news"))
  .filter((a) => a.data.category === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title={`${catName} | News & Insights`}
  description={`Legal updates and insights from Harborview Law on ${catName.toLowerCase()}.`}
>
  <section class="page-hero pad-global">
    <div class="container"><div class="page-hero__inner">
      <span class="eyebrow">News and insights</span>
      <h1 class="h1">{catName}</h1>
    </div></div>
  </section>

  <section class="section pad-global">
    <div class="container">
      <nav class="cat-filter" aria-label="Filter by category">
        <a href="/news-and-insight">View all</a>
        {
          Object.entries(NEWS_CATEGORIES).map(([slug, name]) => (
            <a href={`/news-category/${slug}`} class={slug === category ? "is-active" : ""}>
              {name}
            </a>
          ))
        }
      </nav>
      <div class="article-grid">
        {articles.map((a) => <ArticleCard slug={a.id} {...a.data} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
