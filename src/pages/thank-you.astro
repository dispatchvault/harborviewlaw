---
import Base from "../layouts/Base.astro";
---

<Base title="Thank You" description="Your message has been received.">
  <section class="section pad-global">
    <div class="container" style="max-width: 40rem; text-align: center;">
      <span class="eyebrow">Message received</span>
      <h1 class="h2" style="margin: 1rem 0 1.5rem;">Thank You!</h1>
      <p class="lede muted" style="margin: 0 auto 2rem;">
        Your message has been received. We'll be in touch soon.
      </p>
      <a href="/" class="btn">Back to Home</a>
    </div>
  </section>
</Base>
